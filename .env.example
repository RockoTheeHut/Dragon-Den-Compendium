# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# A placeholder value is rejected at startup unless REQUIRE_STRONG_SECRET_KEY=0.
SECRET_KEY=replace-me
REQUIRE_STRONG_SECRET_KEY=1
# Optional dedicated key for encrypting stored user API keys. If unset, a key
# derived from SECRET_KEY is used (rotating SECRET_KEY then invalidates them).
FIELD_ENCRYPTION_KEY=
DEBUG=false
ALLOWED_HOSTS=127.0.0.1,localhost
SQLITE_PATH=
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=America/New_York
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5-mini
SERVER_COMPENDIUM_XML_PATH=/app/compendium_xml/server-compendium.xml
SERVER_COMPENDIUM_SYSTEM=dnd5e
COMPENDIUM_IMPORT_ASYNC=1
DJANGO_MIGRATE=1
DJANGO_COLLECTSTATIC=1
PERF_GUARD_ON_STARTUP=1
PERF_GUARD_STARTUP_ITERATIONS=2
PORT=8000
WEB_PORT_BIND=127.0.0.1:8000:8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_CONTENT_TYPE_NOSNIFF=1
SECURE_REFERRER_POLICY=same-origin
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
# Set to 1 only when running behind a reverse proxy (Caddy) that sets
# X-Forwarded-Proto; trusting it while directly reachable lets clients spoof it.
TRUST_PROXY_SSL_HEADER=0

# Reverse proxy (Caddy)
CADDY_SITE_ADDRESS=localhost
CADDY_EMAIL=
